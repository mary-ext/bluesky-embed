{
	"name": "bluesky-profile-card-embed",
	"version": "1.0.1",
	"description": "Custom element for embedding Bluesky profile cards",
	"license": "MIT",
	"author": "externdefs",
	"repository": {
		"type": "git",
		"url": "https://github.com/mary-ext/bluesky-embed",
		"directory": "packages/bluesky-profile-card-embed"
	},
	"files": [
		"dist/",
		"themes/"
	],
	"type": "module",
	"exports": {
		".": "./dist/wc.js",
		"./core": "./dist/core.js",
		"./style.css": "./dist/core.css",
		"./themes/*": "./themes/*"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm run check && tsdown && rsync -aHAX --delete ../../themes/ themes/",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.lib.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@atcute/bluesky": "^2.1.1",
		"@atcute/bluesky-richtext-parser": "^1.0.7",
		"@atcute/client": "^3.1.0"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@tsconfig/svelte": "^5.0.8",
		"@tsdown/css": "^0.23.0",
		"@types/node": "^26.6.3",
		"internal": "workspace:^",
		"preact": "^10.29.8",
		"svelte": "catalog:",
		"svelte-check": "^4.7.6",
		"tsdown": "^0.23.0",
		"vite": "^8.3.1"
	}
}
