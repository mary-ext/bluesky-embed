{
	"compilerOptions": {
		"types": ["node"],
		"skipLibCheck": true,
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"noUncheckedSideEffectImports": true,
		"allowImportingTsExtensions": true
	},
	"include": ["tsdown.config.ts", "vite.config.ts"]
}
